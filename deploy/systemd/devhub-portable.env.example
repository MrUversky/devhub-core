# Install as /etc/devhub/devhub.env with root:devhub ownership and mode 0640.
# Set this to the public DevHub repository or another reviewed sanitized fork.
DEVHUB_REPOSITORY_URL=https://github.com/your-org/devhub.git
# Prefer one annotated release tag and its separately reviewed peeled commit.
DEVHUB_RELEASE_TAG=v1.0.0-rc.6
DEVHUB_EXPECTED_COMMIT=replace-with-full-peeled-public-tag-commit
# Legacy reviewed branches remain supported when both tag fields above are
# removed. Never configure a tag and branch together.
# DEVHUB_BRANCH=protected-release-branch
# Keep this dedicated: the updater refuses broad filesystem roots.
DEVHUB_ROOT=/opt/devhub
DEVHUB_CATALOG_DIR=/var/lib/devhub/catalog-repository/catalog
NODE_ENV=production
DEVHUB_HOST_ID=devhub-server
DEVHUB_INSTANCE_MODE=private
DEVHUB_INSTANCE_LABEL="Private workspace"
DEVHUB_BIND_ADDRESS=127.0.0.1
DEVHUB_PORT=3000
# Central cache cadence. Browser refreshes do not bypass these safe intervals.
DEVHUB_STATUS_PROBE_INTERVAL_SECONDS=300
DEVHUB_STATUS_ON_DEMAND_INTERVAL_SECONDS=900
DEVHUB_STATUS_MAX_CONCURRENCY=4
DEVHUB_STATUS_JITTER_PERCENT=10
# `network` trusts the deployment's private network or reverse proxy boundary.
# For direct remote MCP clients, set `bearer` and provide a random value of at
# least 32 bytes through a root-readable EnvironmentFile instead of committing it.
DEVHUB_MCP_AUTH_MODE=network
DEVHUB_MCP_TOKEN=
WRANGLER_WRITE_LOGS=false
WRANGLER_LOG_PATH=/var/lib/devhub/wrangler.log
MINIFLARE_REGISTRY_PATH=/var/lib/devhub/miniflare
