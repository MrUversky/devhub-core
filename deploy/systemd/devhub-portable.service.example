[Unit]
Description=DevHub self-hosted service registry
Documentation=https://github.com/your-org/devhub/blob/main/docs/INSTALLATION.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=devhub
Group=devhub
Environment=HOME=/var/lib/devhub
EnvironmentFile=/etc/devhub/devhub.env
StateDirectory=devhub
UMask=0027
ExecStart=/usr/local/libexec/devhub-portable-run
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/devhub

[Install]
WantedBy=multi-user.target
