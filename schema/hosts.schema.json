{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devhub.example/schema/hosts.schema.json",
  "title": "DevHub hosts catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "hosts"],
  "properties": {
    "version": { "const": 1 },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/host" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "location"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["mac", "linux", "cloud"] },
        "location": { "enum": ["local", "remote", "cloud"] },
        "tailscaleName": { "type": "string", "minLength": 1 },
        "tailscaleIPv4": {
          "type": "string",
          "pattern": "^100\\.(?:6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\\.(?:[0-9]{1,3})\\.(?:[0-9]{1,3})$"
        }
      }
    }
  }
}
