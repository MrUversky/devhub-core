{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devhub.example/schema/project.schema.json",
  "title": "DevHub project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "title",
    "registration",
    "description",
    "lifecycle",
    "kind",
    "services"
  ],
  "properties": {
    "version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "registration": { "enum": ["native", "overlay"] },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "description": { "type": "string", "minLength": 1 },
    "lifecycle": { "enum": ["discovery", "active", "production", "paused", "archived"] },
    "kind": { "type": "string", "minLength": 1 },
    "repository": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "workspaces": {
      "type": "array",
      "items": { "$ref": "#/$defs/workspace" }
    },
    "services": {
      "type": "array",
      "items": { "$ref": "#/$defs/service" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "path"],
      "properties": {
        "host": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url", "successStatuses"],
      "properties": {
        "type": { "const": "http" },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "successStatuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 100, "maximum": 599 }
        },
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 }
      }
    },
    "reported": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "enum": ["up", "down", "stopped", "degraded", "registered", "unknown"] },
        "observedAt": { "type": "string", "format": "date-time" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string", "minLength": 1 },
        "stop": { "type": "string", "minLength": 1 },
        "restart": { "type": "string", "minLength": 1 },
        "logs": { "type": "string", "minLength": 1 },
        "verify": { "type": "string", "minLength": 1 },
        "deploy": { "type": "string", "minLength": 1 }
      }
    },
    "serviceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "url"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "enum": ["primary", "dashboard", "docs", "repository", "logs", "console"]
        },
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
      }
    },
    "serviceEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fallback"],
      "properties": {
        "canonical": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "fallback": { "type": "string", "format": "uri", "pattern": "^https?://" }
      }
    },
    "readinessEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "check", "state", "source", "note"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "check": {
          "enum": ["monitoring", "alerting", "backup", "restore", "rollback", "security-review", "privacy", "ownership", "cost", "deployment"]
        },
        "state": { "enum": ["verified", "declared", "missing", "not-applicable", "unknown"] },
        "source": { "enum": ["operator", "agent", "integration", "catalog"] },
        "note": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" },
        "validUntil": { "type": "string", "format": "date-time" },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
      }
    },
    "passportDeployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "enum": ["operator", "agent", "integration", "catalog"] },
        "provider": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1, "maxLength": 200 },
        "deployedAt": { "type": "string", "format": "date-time" },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
      }
    },
    "passportDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "criticality"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": ["data-store", "external-api", "auth", "payment", "messaging", "storage", "ai-model", "other"]
        },
        "name": { "type": "string", "minLength": 1 },
        "criticality": { "enum": ["required", "degraded", "optional"] },
        "provider": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "evidence"],
      "properties": {
        "profile": { "enum": ["personal", "internal", "customer-facing", "sensitive"] },
        "owner": { "type": "string", "minLength": 1 },
        "dataClassification": { "enum": ["none", "internal", "personal", "sensitive", "regulated", "unknown"] },
        "costModel": { "enum": ["free", "fixed", "metered", "unknown"] },
        "deployment": { "$ref": "#/$defs/passportDeployment" },
        "dependencies": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/passportDependency" }
        },
        "evidence": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/readinessEvidence" }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "environment", "host", "runtime", "mode", "visibility"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "host": { "$ref": "#/$defs/id" },
        "runtime": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["always-on", "on-demand", "managed", "internal"] },
        "visibility": { "enum": ["public", "authenticated", "tailnet", "local", "internal"] },
        "description": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "endpoint": { "$ref": "#/$defs/serviceEndpoint" },
        "readiness": { "$ref": "#/$defs/readiness" },
        "links": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/serviceLink" }
        },
        "probe": { "$ref": "#/$defs/probe" },
        "reported": { "$ref": "#/$defs/reported" },
        "commands": { "$ref": "#/$defs/commands" }
      }
    }
  }
}
